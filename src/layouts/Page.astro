---
import NavBar from "@/components/NavBar.astro";
import Footer from "@/components/Footer.astro";
import { ClientRouter, fade } from "astro:transitions";

interface Props {
    title?: string;
    description?: string;
}

const {title, description} = Astro.props;

const metaTitle = `${title ? title + " >> " : ""}notso[kodya]`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0" />
        <link rel="manifest" href="/site.webmanifest" />
        <link rel="stylesheet" href="/global.css" />

        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
        <link rel="shortcut icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
        <meta name="apple-mobile-web-app-title" content="notso[kodya]" />

		<title>{metaTitle}</title>
        <meta name="title" content={metaTitle} />
        <meta name="description" content={description} />
        <meta name="theme-color" content="#8067eb" />

        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://notsokodya.ru" />
        <meta property="og:title" content={metaTitle} />
        <meta property="og:description" content={description} />

        <ClientRouter />
	</head>

	<body>
        <NavBar />
        <canvas id="dithered-background" />
        <main transition:animate={fade({duration: "0.25s"})}>
            <slot />
        </main>
        <Footer />
	</body>
</html>

<script>
    import { createNoise2D } from "simplex-noise";

    let canvas = document.getElementById("dithered-background") as HTMLCanvasElement;
    let ctx = canvas.getContext("2d");
    const noise = createNoise2D();

    const grid_scale = 0.002;
    const time_factor = 0.005;
    let reconfig = true;

    function gradientChoose(x: number = 0, y: number = 0) {
        const noise2D = Math.abs(noise(x * grid_scale, y * grid_scale));

        if (noise2D <= 0.25) return " ";
        if (noise2D <= 0.45) return "░";
        if (noise2D <= 0.65) return "▒";
        if (noise2D <= 0.85) return "▓";

        return "█"
    }

    function resize() {
        canvas.width = window.outerWidth;
        canvas.height = window.outerHeight;
        reconfig = true;
    }
    function draw() {
        if (!ctx) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        const time = Date.now() * time_factor;
        const scrollY = window.scrollY * 0.5;

        if (reconfig) {
            ctx.font = "30px Iosevka";
            ctx.fillStyle = "rgb(35 38 47)";
            reconfig = false;
        }

        for (let y = 20; y < canvas.height; y += 38) {
            let row = "";
            for (let x = 0; x < canvas.width; x += 18) {
                row += gradientChoose(x + time, y - time + scrollY);
            }

            ctx.fillText(row, 0, y);
        }

        requestAnimationFrame(draw);
    }

    draw();
    resize();

    window.addEventListener("resize", resize);
    document.addEventListener("astro:page-load", () => {
        canvas = document.getElementById("dithered-background") as HTMLCanvasElement;
        ctx = canvas.getContext("2d");
        resize();
    });
</script>

<style>
    main {
        min-height: calc(100vh - 8rem);
        max-width: 1000px;
        width: 100%;

        margin-left: auto;
        margin-right: auto;

        padding-left: .5rem;
        padding-right: .5rem;
        padding-bottom: 1rem;
    }

    #dithered-background {
        position: fixed;

        top: 0;
        left: 0;

        width: 100vw;
        height: 100vh;
        opacity: 0.5;

        overflow: hidden;
        z-index: -1000;
    }
</style>
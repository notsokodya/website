---
import { getWebsiteVersion } from "@/utils/helpers"

const {hash, date} = await getWebsiteVersion();
---

<footer>
    <div class="container">
        <div>
            <span>made with &lt;3</span><br>
            <span>© 2025-{(new Date()).getFullYear()} <mark>notsokodya</mark></span>
        </div>

        <div>
            <span>last updated on <mark>{date}</mark></span><br>
            <span><a href="https://github.com/notsokodya/website" target="_blank">source code</a> ({hash})</span>
        </div>
    </div>
</footer>

<style>
    footer {
        font-weight: 600;
        font-size: .9rem;

        width: 100%;
        padding: 0;

        display: flex;
    }

    .container {
        width: 100%;
        max-width: 1200px;

        display: flex;
        justify-content: space-between;

        padding: 1rem 2rem;

        margin-left: auto;
        margin-right: auto;

        border-top: solid var(--border-width) var(--border-color);
        background-color: var(--background-color);
        color: var(--text-shade-color);
    }

    .container div:last-child {
        text-align: right;
    }
</style>
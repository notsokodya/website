---
import NavLink from "./NavLink.astro"
---

<header class="navbar">
    <div class="container">
        <a href="/" class="title">
            <div class="notsokodya">notso<span>kodya</span></div>
        </a>
        <nav class="links">
            <NavLink href="/" class="link">
                <span>[home]</span>
            </NavLink>
            <NavLink href="/about" class="link">
                <span>[about]</span>
            </NavLink>
            <NavLink href="/projects" class="link">
                <span>[projects]</span>
            </NavLink>
        </nav>
    </div>
</header>
<div class="placeholder" />

<style>
    .navbar {
        user-select: none;
        font-weight: 600;

        position: fixed;
        top: 0%;
        left: 0%;

        width: 100%;
        height: 4rem;
        max-height: 4rem;

        padding: 0px;

        display: flex;
        z-index: 1000;
    }

    .container {
        width: 100%;
        max-width: 1200px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0 2rem;

        margin-left: auto;
        margin-right: auto;

        background-color: var(--background-color);
    }

    .title {
        padding: .75rem;

        display: flex;
        flex-direction: row;
        gap: .5rem;

        align-items: center;
        text-align: center;

        color: var(--text-color);
    }
    .notsokodya {
        background-color: transparent;
        color: var(--primary-color);
        font-weight: 600;

        transition: .125s;
    }
    .notsokodya > span {
        padding: .1rem .15rem;
        margin-left: .1rem;

        background-color: var(--primary-color);
        color: var(--background-color);

        transition: .125s;
    }
    .title:hover > .notsokodya {
        color: var(--primary-tint-color);
    }
    .title:hover > .notsokodya > span {
        background-color: var(--primary-tint-color);
    }

    .links {
        display: flex;
        flex-direction: row;
    }

    .link {
        padding: .75rem;

        display: flex;
        flex-direction: row;
        align-items: center;
        font-weight: 600;

        color: var(--primary-color);
    }
    .link span {
        padding: .1rem .15rem;
        transition: .125s;
    }
    .link:hover span {
        background-color: var(--primary-color);
        color: var(--background-color);
    }
    .link:is(.active) span {
        background-color: var(--primary-color);
        color: var(--background-color);
    }
    .link:is(.active):hover span {
        background-color: var(--primary-tint-color);
    }

    .placeholder {
        width: 100%;
        height: 4rem;
        min-height: 4rem;
    }
</style>
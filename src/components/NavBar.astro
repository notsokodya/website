---
import NavLink from "./NavLink.astro"
---

<header class="navbar">
    <div class="container">
        <a href="/" class="title">
            <div class="notsokodya">notso<span>kodya</span></div>
        </a>
        <nav class="links">
            <NavLink href="/" class="link">
                <span>[home]</span>
            </NavLink>
            <NavLink href="/about" class="link">
                <span>[about]</span>
            </NavLink>
            <NavLink href="/projects" class="link">
                <span>[projects]</span>
            </NavLink>
        </nav>
        <button class="navbtn" id="navbutton"><span>[=]</span></button>
    </div>
    <div class="drawer" id="drawer">
        <nav class="links">
            <NavLink href="/" class="link">
                <span>[home]</span>
            </NavLink>
            <NavLink href="/about" class="link">
                <span>[about]</span>
            </NavLink>
            <NavLink href="/projects" class="link">
                <span>[projects]</span>
            </NavLink>
        </nav>
    </div>
</header>
<div class="placeholder" />

<script>
    import { signal, effect } from "@preact/signals";

    const button = document.querySelector("#navbutton") as HTMLElement;
    const drawer = document.querySelector("#drawer") as HTMLElement;

    const visible = signal(false);

    effect(() => {
        button.setAttribute("aria-expanded", String(visible.value));

        if (visible.value) {
            drawer.style.removeProperty("display");
            setTimeout(() => drawer.classList.add("open"), 1);
            document.documentElement.style.overflowY = "hidden";
        } else {
            drawer.classList.remove("open");
        }
    });

    drawer.addEventListener("transitionend", () => {
        if (!visible.value) {
            drawer.style.display = "none";
            document.documentElement.style.removeProperty("overflow-y");
        }
    });

    button.addEventListener("click", () => {
        visible.value = !visible.value;
    });
</script>

<style>
    .navbar {
        user-select: none;
        font-weight: 600;

        position: fixed;
        top: 0%;
        left: 0%;

        width: 100%;
        height: 4rem;
        max-height: 4rem;

        padding: 0px;

        display: flex;
        z-index: 1000;
    }

    .container {
        width: 100%;
        max-width: 1200px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 0 2rem;

        margin-left: auto;
        margin-right: auto;

        background-color: var(--background-color);
    }

    .title {
        padding: .75rem;

        display: flex;
        flex-direction: row;
        gap: .5rem;

        align-items: center;
        text-align: center;

        color: var(--text-color);
    }
    .notsokodya {
        background-color: transparent;
        color: var(--primary-color);
        font-weight: 600;

        transition: .125s;
    }
    .notsokodya > span {
        padding: .1rem .15rem;
        margin-left: .1rem;

        background-color: var(--primary-color);
        color: var(--background-color);

        transition: .125s;
    }
    .title:hover > .notsokodya {
        color: var(--primary-tint-color);
    }
    .title:hover > .notsokodya > span {
        background-color: var(--primary-tint-color);
    }

    .links {
        display: flex;
        flex-direction: row;
    }

    .link {
        padding: .75rem;

        display: flex;
        flex-direction: row;
        align-items: center;
        font-weight: 600;

        color: var(--primary-color);
    }
    .link span {
        padding: .1rem .15rem;
        transition: .125s;
    }
    .link:hover span {
        background-color: var(--primary-color);
        color: var(--background-color);
    }
    .link:is(.active) span {
        background-color: var(--primary-color);
        color: var(--background-color);
    }
    .link:is(.active):hover span {
        background-color: var(--primary-tint-color);
    }

    .navbtn {
        display: none;

        font-family: var(--font-one);
        font-size: 1rem;
        font-weight: 600;

        cursor: pointer;
        color: var(--primary-color);
        background-color: transparent;
        border: inherit;
    }
    .navbtn span {
        padding: .75rem .5rem;
        transition: .125s;
    }
    .navbtn:hover span {
        color: var(--background-color);
        background-color: var(--primary-color);
    }

    .drawer {
        position: fixed;
        top: 4rem;
        width: 100vw;
        height: calc(100vh - 4rem);

        opacity: 0;
        background-color: var(--background-color);
        transition: .125s;
    }
    .drawer:is(.open) {
        opacity: 1;
    }
    .drawer .links {
        flex-direction: column;
    }
    .drawer .link {
        font-size: 1.25rem;
        justify-content: center;
    }
    .drawer .link span {
        padding: .75rem .75rem;
    }

    .placeholder {
        width: 100%;
        height: 4rem;
        min-height: 4rem;
    }

    @media screen and (width <= 800px) {
        .container > .links {
            display: none;
        }
        .navbtn {
            display: inline;
        }
    }
</style>
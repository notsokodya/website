---
import Layout from "@/layouts/Page.astro";
---

<Layout title="404: not found" description="whuh, where did u even go??? ;w;">
    <div class="head">
        <img
            src="/assets/404_tree.gif"
            width="256px"
            height="256px"
        />

        <div class="container">
            <h1>404</h1>
            <p>where are you even??</p>
        </div>
    </div>
</Layout>

<style>
    .head {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .container {
        display: flex;
        flex-direction: column;
        text-align: center;
        align-items: center;
    }

    .container > h1 {
        padding: .25rem .5rem;
    }
</style>
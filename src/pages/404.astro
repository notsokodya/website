---
import Layout from "@/layouts/Page.astro";
---

<Layout title="not found" description="[404] lost page uwu">
    <div class="head">
        <img
            src="/assets/404_tree.gif"
            width="256px"
            height="256px"
        />

        <div class="container">
            <h1>404</h1>
            <p>you're lost, aren't you? owo</p>
        </div>
    </div>
</Layout>

<style>
    .head {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .container > h1 {
        margin: 1rem;

        font-size: 3.25rem;
        color: var(--text-color);
        background-color: unset;
    }
    .container > p {
        color: var(--text-shade-color);
    }
</style>
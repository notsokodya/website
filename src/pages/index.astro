---
import Layout from "@/layouts/Page.astro";
import Desc from "@/components/home/desc";
---

<Layout description="meow meow mrow :3">
    <div class="hero">
        <div>
            <h1 class="notsokodya">
                notso<span>kodya</span>
            </h1>
            <Desc
                client:idle
                className="desc"
            />
        </div>

        <img
            src="/assets/pfp.png"
            width="200"
            height="200"
            class="pfp"
        />
    </div>

    <section>
        <h2 class="title">introduction</h2>
        <div class="strip"/>

        <p>
            haiii, i&apos;m <strong>Kodya</strong>, jack of all trades, master of none. student, self-taught programmer, artist and owner of other various skills.
        </p>

        <p>
            usually i play games, write code and do random stuff on the internet<br/>
            also sometimes i go outside (to touch grass)
        </p>
    </section>
</Layout>

<style>
    .hero {
        max-width: fit-content;
        padding: 2rem 0;
        margin: 0 auto;

        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 2rem;

        text-align: center;
    }

    .notsokodya {
        background-color: transparent;
        color: var(--primary-color);
        font-weight: 600;
    }
    .notsokodya > span {
        padding: .1rem .15rem;
        margin-left: .1rem;

        background-color: var(--primary-color);
        color: var(--background-color);
    }

    .desc {
        opacity: 1;
        transition: .125s ease-out;
    }
    .desc:is(.hide) {
        opacity: 0;
    }

    .pfp {
        outline: solid var(--border-width) var(--primary-color);
        outline-offset: .5rem;
    }


    section {
        margin-top: 1rem;
        margin-bottom: 1rem;
    }

    section > .title {
        width: fit-content;
        padding: .1rem .5rem;
        margin-bottom: .5rem;
        margin-top: 2.25rem;

        font-size: 1.2rem;
        color: var(--primary-color);
        background-color: transparent;
        border-left: solid .3rem var(--primary-color);
    }

    section > .strip {
        padding: 1rem;
        margin: 1rem 0;

        border: solid .3rem var(--primary-color);
        background-image: repeating-linear-gradient(45deg, transparent, transparent 1rem, var(--primary-color) 1rem, var(--primary-color) 1.4rem);
        background-size: 2rem 2rem;
        animation: background-move 4s linear infinite;
    }

    .socials {
        display: grid;
        grid-template-columns: max-content 1fr;
        align-items: stretch;

        padding: 0;
        margin: 0;

        list-style: none;
    }

    .social {
        display: contents;
    }
    .social > span {
        margin-right: .5rem;
        text-align: right;
    }
    .social > a {
        width: fit-content;
    }

    .buttons {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(88px, 1fr));
        align-items: stretch;

        gap: .5rem;

        padding: 0;
        margin: 0;

        list-style: none;
    }

    .b88x31 {
        text-decoration: none;
    }

    .b88x31 > img {
        transition: .125s;
    }

    .b88x31:hover > img {
        transform: scale(1.1);
    }

    @keyframes background-move {
        from {
            background-position: 0 0;
        }

        to {
            background-position: 8rem 0;
        }
    }

    @media screen and (width <= 800px) {
        .hero {
            flex-direction: column-reverse;
        }

        .tracks {
            justify-content: center;
        }
    }
</style>
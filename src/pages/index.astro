---
import Layout from "@/layouts/Page.astro";
import Desc from "@/components/home/desc";
import LastFM from "@/components/home/lastfm";
---

<Layout description="meow meow mrow :3">
    <div class="hero">
        <div>
            <h1 class="notsokodya">
                notso<span>kodya</span>
            </h1>
            <Desc
                client:idle
                transition:persist="notsokodya_desc"
                className="desc"
            />
        </div>

        <img
            src="/assets/pfp.png"
            width="200"
            height="200"
            class="pfp"
        />
    </div>

    <section>
        <h2 class="title">introduction</h2>
        <div class="strip"/>

        <p>
            haiii, i&apos;m <strong>Kodya</strong>, jack of all trades, master of none. student, self-taught programmer, artist and owner of other various skills.
        </p>

        <p>
            usually i play games, write code and do random stuff on the internet<br/>
            also sometimes i go outside (to touch grass)
        </p>
    </section>

    <section>
        <h2 class="title">recently listened</h2>
        <p>my horrible music taste :3</p>
        <LastFM className="tracks" client:idle/>
    </section>

    <section>
        <h2 class="title">socials & contact</h2>
        <p>i do exist almost in every corner of the internet<br/>also feel free to text me :3</p>

        <ul class="socials">
            <li class="social">
                <span>[discord]</span>
                <a target="_blank" href="https://discord.com/users/271535529789620224">@notsokodya</a>
            </li>
            <li class="social">
                <span>[telegram]</span>
                <a target="_blank" href="https://t.me/notsokodya">notsokodya</a>
            </li>

            <li class="social">
                <span>[bluesky]</span>
                <a target="_blank" href="https://bsky.app/profile/notsokodya.bsky.social">notsokodya.bsky.social</a>
            </li>
            <li class="social">
                <span>[youtube]</span>
                <a target="_blank" href="https://www.youtube.com/@notsokodya">@notsokodya</a>
            </li>
            <li class="social">
                <span>[github]</span>
                <a target="_blank" href="https://github.com/notsokodya">/notsokodya</a>
            </li>
        </ul>
    </section>

    <section>
        <h2 class="title">88x31 buttons</h2>
        <p>friends :3</p>
    </section>
</Layout>

<style>
    .hero {
        max-width: fit-content;
        padding: 2rem 0;
        margin: 0 auto;

        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 2rem;

        text-align: center;
    }

    .notsokodya {
        background-color: transparent;
        color: var(--primary-color);
        font-weight: 600;
    }
    .notsokodya > span {
        padding: .1rem .15rem;
        margin-left: .1rem;

        background-color: var(--primary-color);
        color: var(--background-color);
    }

    .desc {
        opacity: 1;
        transition: .125s ease-out;
    }
    .desc:is(.hide) {
        opacity: 0;
    }

    .pfp {
        outline: solid var(--border-width) var(--primary-color);
        outline-offset: .5rem;
    }


    section {
        margin-top: 1rem;
        margin-bottom: 1rem;
    }

    section > .title {
        width: fit-content;
        padding: .1rem .5rem;
        margin-bottom: .5rem;
        margin-top: .15rem;

        font-size: 1.2rem;
        color: var(--primary-color);
        background-color: transparent;
        border-left: solid .3rem var(--primary-color);
    }

    section > .strip {
        padding: 1rem;
        margin: 1rem 0;

        border: solid .3rem var(--primary-color);
        background-image: repeating-linear-gradient(45deg, transparent, transparent 1rem, var(--primary-color) 1rem, var(--primary-color) 1.4rem);
        background-size: 2rem 2rem;
        animation: background-move 4s linear infinite;
    }

    .tracks {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;

        padding: 0;
        margin: 0;

        list-style: none;
    }

    .tracks .track {
        width: 160px;

        display: flex;
        flex-direction: column;
        gap: .5rem;

        color: var(--text-shade-color);
        transition: .125s;
    }
    .tracks .meta {
        display: flex;
        flex-direction: column;

        text-align: center;
        align-items: center;
    }
    .tracks img {
        outline: solid 1px var(--border-color);
        transition: .2s ease-out;
    }
    .tracks .title {
        text-overflow: ellipsis;
        overflow: hidden;
        word-wrap: anywhere;

        color: var(--text-color);
        background-color: transparent;
    }
    .tracks .artist {
        font-size: 0.9rem;
    }
    .tracks .loved {
        color: var(--primary-color);
    }
    .tracks .playing {
        color: var(--text-color);
    }

    .tracks .track:hover img {
        transform: perspective(160px) translateY(-4px) rotateX(5deg);
        outline-color: var(--primary-color);
    }

    .socials {
        display: grid;
        grid-template-columns: max-content 1fr;
        align-items: stretch;

        padding: 0;
        margin: 0;

        list-style: none;
    }

    .social {
        display: contents;
    }
    .social > span {
        margin-right: .5rem;
        text-align: right;
    }
    .social > a {
        width: fit-content;
    }

    @keyframes background-move {
        from {
            background-position: 0 0;
        }

        to {
            background-position: 8rem 0;
        }
    }

    @media screen and (width <= 700px) {
        .hero {
            flex-direction: column-reverse;
        }
    }
</style>
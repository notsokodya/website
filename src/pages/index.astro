---
import Layout from "@/layouts/Page.astro";
import Desc from "@/components/home/desc";
---

<Layout description="meow meow mrow :3">
    <div class="hero">
        <div>
            <h1 class="notsokodya">
                notso<span>kodya</span>
            </h1>
            <Desc
                client:idle
                transition:persist="notsokodya_desc"
                className="desc"
            />
        </div>

        <img
            src="/assets/pfp.png"
            width="200"
            height="200"
            class="pfp"
        />
    </div>
</Layout>

<style>
    .hero {
        max-width: fit-content;
        padding: 2rem 0;
        margin: 0 auto;

        display: flex;
        flex-direction: row;
        justify-content: space-between;
        gap: 2rem;

        text-align: center;
    }

    .notsokodya {
        background-color: transparent;
        color: var(--primary-color);
        font-weight: 600;
    }
    .notsokodya > span {
        padding: .1rem .15rem;
        margin-left: .1rem;

        background-color: var(--primary-color);
        color: var(--background-color);
    }

    .desc {
        opacity: 1;
        transition: .125s ease-out;
    }
    .desc:is(.hide) {
        opacity: 0;
    }

    .pfp {
        outline: solid var(--border-width) var(--primary-color);
        outline-offset: .5rem;
    }
</style>